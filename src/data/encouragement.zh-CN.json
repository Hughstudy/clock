  "interfaceCopy": [
    {
      "id": "UI05",
      "text": "结束专注",
      "condition": "与暂停／继续同组；只打开结束确认，不使用“结束这段”。"
    },
    {
      "id": "UI10",
      "text": "这次想做什么？（选填）",
      "condition": "可选，不用于评分。"
    },
    {
      "id": "UI11",
      "text": "接下来，想先做哪一步？",
      "condition": "允许留空，不能预填成用户已经承诺的任务。"
    },
    {
      "id": "UI12",
      "text": "留个标记",
      "condition": "一次点击立即创建空标记，不开键盘；不称为分心计数。"
    },
    {
      "id": "UI16",
      "text": "回到这一步",
      "condition": "只在对应步骤仍存在时使用。"
    },
    {
      "id": "UI17",
      "text": "回到计时",
      "condition": "会话之外的独立想法面板用“返回”，不虚构计时上下文。"
    },
    {
      "id": "UI18",
      "text": "撤销标记",
      "condition": "绑定原创建ID、版本与世代；不按“最近一条”猜目标，已补字或变化则原快捷撤销失效。"
    },
    {
      "id": "UI19",
      "text": "给我一句鼓励",
      "condition": "直接显示ASKG，不强制先分类。"
    },
    {
      "id": "UI26",
      "text": "已暂停",
      "condition": "所有需要显示计时状态的位置保持一致。"
    },
    {
      "id": "UI27",
      "text": "计时中",
      "condition": "不写“你正在高效专注”。"
    },
    {
      "id": "UI28",
      "text": "上次专注已暂停，可以继续或结束。",
      "condition": "仅确认恢复的是暂停专注时使用；不套休息。"
    },
    {
      "id": "UI29",
      "text": "这段正在计时。",
      "condition": "只有确实仍在运行时使用；已到期先结算。"
    },
    {
      "id": "UI30",
      "text": "本段计时{elapsed}。",
      "condition": "与END情绪句分工；时长来自真实记录。"
    },
    {
